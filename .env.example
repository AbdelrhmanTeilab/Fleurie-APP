# Leave DATABASE_URL empty to use the built-in local database (.data/pglite).
# For hosting, set a Postgres URL (for example from Neon) and the app migrates it automatically.
DATABASE_URL=
# Long random string for signing cookies. Required in production.
AUTH_SECRET=
# Email (Resend). Without it, emails wait in Admin > Outbox for manual sending.
RESEND_API_KEY=
EMAIL_FROM=Fleurie <no-reply@yourdomain.com>
# WhatsApp Cloud API (Meta). Without it, WhatsApp messages wait in Admin > Outbox.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=otp_code
WHATSAPP_MSG_TEMPLATE=
# Public site address, used inside messages and reminders.
APP_URL=https://your-domain.com
# Secret (16+ chars) for the reminders endpoint: POST/GET /api/cron/reminders with "Authorization: Bearer <secret>".
CRON_SECRET=
